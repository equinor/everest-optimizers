from collections.abc import Callable, Sequence
from typing import ClassVar

import numpy as np
from numpy.typing import ArrayLike, NDArray

_EvaluateCallback = Callable[
    [NDArray[np.float64], int],
    tuple[NDArray[np.float64] | None, NDArray[np.float64] | None],
]

class SerialDenseVector:
    def __init__(self, arg0: ArrayLike) -> None: ...
    def to_numpy(self) -> NDArray[np.float64]: ...

class SerialDenseMatrix:
    def __init__(self, arg0: ArrayLike) -> None: ...

class NLPBase: ...

class NLP:
    def __init__(self, base: NLPBase) -> None: ...

class NLF1(NLPBase):
    def getXc(self) -> SerialDenseVector: ...
    def setIsExpensive(self, is_expensive: bool) -> None: ...
    def setModeOverride(self, override_mode: bool) -> None: ...
    def setConstraints(self, compound_constraint: CompoundConstraint) -> None: ...

class ObjectiveNLF1(NLF1):
    def __init__(
        self, ndim: int, nconstraints: int, evaluate: _EvaluateCallback, x0: SerialDenseVector
    ) -> None: ...

class ConstraintNLF1(NLF1):
    def __init__(self, ndim: int, nconstraints: int, evaluate: _EvaluateCallback) -> None: ...

class ConstraintBase: ...
class CompoundConstraint: ...

class BoundConstraint(ConstraintBase):
    def __init__(
        self, nc: int, lower: SerialDenseVector, upper: SerialDenseVector
    ) -> None: ...

class LinearEquation(ConstraintBase):
    def __init__(self, A: SerialDenseMatrix, rhs: SerialDenseVector) -> None: ...

class LinearInequality(ConstraintBase):
    def __init__(
        self, A: SerialDenseMatrix, lower: SerialDenseVector, upper: SerialDenseVector
    ) -> None: ...

class NonLinearConstraint(ConstraintBase):
    def __init__(
        self,
        nlprob: NLP,
        lower: SerialDenseVector,
        upper: SerialDenseVector,
        ne: int,
        ni: int,
    ) -> None: ...

def create_compound_constraint(
    constraints: Sequence[ConstraintBase],
) -> CompoundConstraint: ...

class SearchStrategy:
    TrustRegion: ClassVar[SearchStrategy]
    LineSearch: ClassVar[SearchStrategy]

class MeritFcn:
    NormFmu: ClassVar[MeritFcn]
    ArgaezTapia: ClassVar[MeritFcn]
    VanShanno: ClassVar[MeritFcn]

class OptQNewton:
    def __init__(self, p: NLF1) -> None: ...
    def cleanup(self) -> None: ...
    def optimize(self) -> None: ...
    def getReturnCode(self) -> int: ...
    def setDebug(self) -> None: ...
    def setOutputFile(self, filename: str, mode: int) -> int: ...
    def setSearchStrategy(self, s: SearchStrategy) -> None: ...
    def setTRSize(self, size: float) -> None: ...
    def setMaxStep(self, max_step: float) -> None: ...
    def setMaxIter(self, max_iterations: int) -> None: ...
    def setMaxFeval(self, max_function_evaluations: int) -> None: ...
    def setFcnTol(self, convergence_tolerance: float) -> None: ...
    def setGradTol(self, gradient_tolerance: float) -> None: ...

class OptBCQNewton:
    def __init__(self, p: NLF1) -> None: ...
    def cleanup(self) -> None: ...
    def optimize(self) -> None: ...
    def getReturnCode(self) -> int: ...
    def setDebug(self) -> None: ...
    def setOutputFile(self, filename: str, mode: int) -> int: ...
    def setSearchStrategy(self, s: SearchStrategy) -> None: ...
    def setTRSize(self, size: float) -> None: ...
    def setMaxStep(self, max_step: float) -> None: ...
    def setMaxIter(self, max_iterations: int) -> None: ...
    def setMaxFeval(self, max_function_evaluations: int) -> None: ...
    def setFcnTol(self, convergence_tolerance: float) -> None: ...
    def setGradTol(self, gradient_tolerance: float) -> None: ...

class OptQNIPS:
    def __init__(self, p: NLF1) -> None: ...
    def cleanup(self) -> None: ...
    def optimize(self) -> None: ...
    def getReturnCode(self) -> int: ...
    def setDebug(self) -> None: ...
    def setOutputFile(self, filename: str, mode: int) -> int: ...
    def setMaxStep(self, max_step: float) -> None: ...
    def setMaxIter(self, max_iterations: int) -> None: ...
    def setMaxFeval(self, max_function_evaluations: int) -> None: ...
    def setFcnTol(self, convergence_tolerance: float) -> None: ...
    def setMeritFcn(self, merit_function: MeritFcn) -> None: ...
    def setCenteringParameter(self, sigma: float) -> None: ...
    def setStepLengthToBdry(self, tau: float) -> None: ...
